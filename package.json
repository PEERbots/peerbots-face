{
  "name": "@peerbots/face",
  "version": "0.1.0",
  "description": "Canonical Peerbots Robot Face rendering engine, assets, viseme sync, TTS audio cache, and modular Zustand slices.",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "Peerbots",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "public/FaceAssets",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./FaceAssets/*": "./public/FaceAssets/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PEERbots/peerbots-face.git"
  },
  "bugs": {
    "url": "https://github.com/PEERbots/peerbots-face/issues"
  },
  "homepage": "https://github.com/PEERbots/peerbots-face#readme",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "test:all": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:fast": "npm run typecheck && npm run lint",
    "check:task": "npm run check:fast && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "@vizij/runtime-react": "^0.1.0",
    "clsx": "^2.1.1",
    "pixi.js": "^8.2.5",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.2.0",
    "@peerbots/core": ">=1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@chromatic-com/storybook": "^5.1.1",
    "@eslint/js": "^9.19.0",
    "@peerbots/core": "^1.2.0",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-onboarding": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "axe-core": "^4.10.2",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.3.3",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.2",
    "vitest-axe": "^0.1.0"
  }
}
