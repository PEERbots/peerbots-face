{
  "id": "peerbots-face",
  "version": "v1",
  "title": "Peerbots Face Extensions",
  "description": "Peerbots-specific face controls composed alongside vizij-face: single theme color, amplitude lip-sync fallback, and scene framing (zoom, offset, rotation).",
  "scope": "face",
  "keys": [
    {
      "path": "peerbots/color/r",
      "kind": "input",
      "value_type": "f32",
      "min": 0.0,
      "max": 1.0,
      "default_value": { "f32": 0.671 },
      "meta": { "tier": "appearance" }
    },
    {
      "path": "peerbots/color/g",
      "kind": "input",
      "value_type": "f32",
      "min": 0.0,
      "max": 1.0,
      "default_value": { "f32": 0.89 },
      "meta": { "tier": "appearance" }
    },
    {
      "path": "peerbots/color/b",
      "kind": "input",
      "value_type": "f32",
      "min": 0.0,
      "max": 1.0,
      "default_value": { "f32": 0.98 },
      "meta": { "tier": "appearance" }
    },
    {
      "path": "peerbots/speech/amplitude",
      "kind": "input",
      "value_type": "f32",
      "min": 0.0,
      "max": 1.0,
      "default_value": { "f32": 0.0 },
      "meta": { "tier": "viseme" }
    },
    {
      "path": "peerbots/scene/scale",
      "kind": "input",
      "value_type": "f32",
      "min": 0.1,
      "max": 4.0,
      "default_value": { "f32": 1.0 },
      "meta": { "tier": "framing" }
    },
    {
      "path": "peerbots/scene/offset/x",
      "kind": "input",
      "value_type": "f32",
      "min": -1.0,
      "max": 1.0,
      "default_value": { "f32": 0.0 },
      "meta": { "tier": "framing" }
    },
    {
      "path": "peerbots/scene/offset/y",
      "kind": "input",
      "value_type": "f32",
      "min": -1.0,
      "max": 1.0,
      "default_value": { "f32": 0.0 },
      "meta": { "tier": "framing" }
    },
    {
      "path": "peerbots/scene/rotation",
      "kind": "input",
      "value_type": "f32",
      "min": 0.0,
      "max": 360.0,
      "default_value": { "f32": 0.0 },
      "meta": { "tier": "framing" }
    }
  ]
}
